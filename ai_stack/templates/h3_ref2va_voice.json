{
  "id": "h3_ref2va_voice",
  "name": "MiniMax H3 Ref2VA + Voice Reference",
  "kind": "video",
  "description": "Reference character + reference voice video via MiniMax H3 and VDN-H3 low-VRAM path.",
  "parameters": {
    "prompt": {"node": "6", "input": "prompt", "type": "string", "required": true},
    "reference_image": {"node": "50", "input": "image", "type": "string", "required": true},
    "reference_audio": {"node": "60", "input": "audio", "type": "string", "required": true},
    "width": {"node": "6", "input": "width", "type": "int", "default": 576, "min": 256, "max": 1024},
    "height": {"node": "6", "input": "height", "type": "int", "default": 320, "min": 256, "max": 1024},
    "frames": {"node": "6", "input": "length", "type": "int", "default": 124, "min": 22, "max": 362},
    "seed": {"node": "8", "input": "noise_seed", "type": "int", "default": 981445682258077},
    "filename_prefix": {"node": "16", "input": "filename_prefix", "type": "string", "default": "eva/h3_ref2va"}
  },
  "workflow": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "cpu"}},
    "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
    "5": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "6": {"class_type": "MiniMaxH3ReferenceToVideo", "inputs": {"prompt": "", "width": 576, "height": 320, "length": 124, "ref_image_size": "match", "clip": ["2", 0], "vae": ["4", 0], "audio_vae": ["5", 0], "ref_images.ref_image_0": ["50", 0], "ref_audios.ref_audio_0": ["60", 0]}},
    "8": {"class_type": "RandomNoise", "inputs": {"noise_seed": 981445682258077}},
    "9": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
    "10": {"class_type": "BasicScheduler", "inputs": {"scheduler": "simple", "steps": 8, "denoise": 1, "model": ["270", 0]}},
    "11": {"class_type": "BasicGuider", "inputs": {"model": ["270", 0], "conditioning": ["6", 0]}},
    "12": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["8", 0], "guider": ["11", 0], "sampler": ["9", 0], "sigmas": ["10", 0], "latent_image": ["6", 1]}},
    "13": {"class_type": "VAEDecode", "inputs": {"samples": ["12", 0], "vae": ["4", 0]}},
    "14": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["12", 0], "vae": ["5", 0]}},
    "15": {"class_type": "CreateVideo", "inputs": {"fps": 24, "bit_depth": "auto", "color_space": "sRGB", "images": ["13", 0], "audio": ["14", 0]}},
    "16": {"class_type": "SaveVideo", "inputs": {"filename_prefix": "eva/h3_ref2va", "format": "auto", "format.codec": "auto", "codec": "auto", "video-preview": "", "video": ["15", 0]}},
    "50": {"class_type": "LoadImage", "inputs": {"image": "example_character.jpg"}},
    "60": {"class_type": "LoadAudio", "inputs": {"audio": "voice_reference.mp3"}},
    "270": {"class_type": "ApplyVDNH3_24GB", "inputs": {"model": ["1", 0], "vdn_checkpoint": "stage-dmd-step-250-int8_convrot_comfyui", "apply_turbo_adapter": true, "strength": 1.0, "lora_mode": "bypass", "branch_weights": "stream", "retain_buffers": "off", "verbose": false, "attention_backend": "grouped"}}
  }
}
