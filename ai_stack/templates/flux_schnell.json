{
  "id": "flux_schnell",
  "name": "FLUX.1 Schnell Text to Image",
  "kind": "image",
  "description": "Fast text-to-image template using the Comfy-Org FLUX.1 Schnell FP8 single-file checkpoint.",
  "parameters": {
    "prompt": {"node": "6", "input": "text", "type": "string", "required": true},
    "width": {"node": "27", "input": "width", "type": "int", "default": 1024, "min": 256, "max": 2048},
    "height": {"node": "27", "input": "height", "type": "int", "default": 1024, "min": 256, "max": 2048},
    "seed": {"node": "31", "input": "seed", "type": "int", "default": 42},
    "steps": {"node": "31", "input": "steps", "type": "int", "default": 4, "min": 1, "max": 20},
    "filename_prefix": {"node": "9", "input": "filename_prefix", "type": "string", "default": "eva/flux"}
  },
  "workflow": {
    "30": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "flux1-schnell-fp8.safetensors"}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["30", 1], "text": "A cinematic technology product photo"}},
    "33": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["30", 1], "text": ""}},
    "27": {"class_type": "EmptySD3LatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "31": {"class_type": "KSampler", "inputs": {"model": ["30", 0], "positive": ["6", 0], "negative": ["33", 0], "latent_image": ["27", 0], "seed": 42, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["31", 0], "vae": ["30", 2]}},
    "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "eva/flux"}}
  }
}
